{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unitybrain.local/schemas/daemon-rpc.schema.json",
  "title": "DaemonRpcProtocol",
  "type": "object",
  "properties": {
    "methods": {
      "type": "object",
      "properties": {
        "index/status": {
          "type": "object",
          "required": ["state", "indexedAssets", "indexedMetas", "lastBuildMs"],
          "properties": {
            "state": { "enum": ["idle", "indexing", "ready", "error"] },
            "indexedAssets": { "type": "integer" },
            "indexedMetas": { "type": "integer" },
            "lastBuildMs": { "type": "number" }
          }
        },
        "index/rebuild": {
          "type": "object",
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "force": { "type": "boolean" },
                "forceFull": { "type": "boolean" }
              }
            },
            "indexedAssets": { "type": "integer" },
            "elapsedMs": { "type": "number" }
          },
          "required": ["indexedAssets", "elapsedMs"]
        },
        "usage/findByScriptGuid": {
          "type": "object",
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "scriptGuid": { "type": "string" },
                "guid": { "type": "string" }
              }
            },
            "locations": { "type": "array" }
          },
          "required": ["locations"]
        },
        "usage/findByMethod": {
          "type": "object",
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "scriptGuid": { "type": "string" },
                "guid": { "type": "string" },
                "className": { "type": "string" },
                "methodName": { "type": "string" }
              },
              "required": ["methodName"]
            },
            "locations": { "type": "array" }
          },
          "required": ["locations"]
        },
        "inspector/getSerializedValues": {
          "type": "object",
          "properties": {
            "params": {
              "type": "object",
              "properties": {
                "scriptGuid": { "type": "string" },
                "guid": { "type": "string" },
                "fieldName": { "type": "string" }
              }
            },
            "fields": { "type": "array" }
          },
          "required": ["fields"]
        }
      }
    }
  }
}
