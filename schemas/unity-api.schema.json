{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unitybrain.local/schemas/unity-api.schema.json",
  "title": "UnityApiDatabase",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "types"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string" },
    "sourceCommit": { "type": "string" },
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fullName", "kind", "events"],
        "properties": {
          "fullName": { "type": "string" },
          "kind": { "enum": ["class", "struct"] },
          "minimumUnityVersion": { "type": "string" },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "returnType", "supportsCoroutine", "description", "parameters"],
              "properties": {
                "name": { "type": "string" },
                "returnType": { "type": "string" },
                "supportsCoroutine": { "type": "boolean" },
                "isStatic": { "type": "boolean" },
                "isPerformanceCritical": { "type": "boolean" },
                "minimumUnityVersion": { "type": "string" },
                "maximumUnityVersion": { "type": "string" },
                "description": { "type": "string" },
                "parameters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "type"],
                    "properties": {
                      "name": { "type": "string" },
                      "type": { "type": "string" },
                      "isOptional": { "type": "boolean" },
                      "description": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
