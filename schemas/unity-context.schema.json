{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unitybrain.local/schemas/unity-context.schema.json",
  "title": "UnityProjectContext",
  "type": "object",
  "required": [
    "projectRoot",
    "editorVersion",
    "editorInstallPath",
    "cgIncludesPath",
    "builtInPackagesPath",
    "manifestPath",
    "packagesLockPath",
    "cacheDir"
  ],
  "properties": {
    "projectRoot": { "type": "string", "minLength": 1 },
    "editorVersion": { "type": "string" },
    "editorInstallPath": { "type": ["string", "null"] },
    "cgIncludesPath": { "type": ["string", "null"] },
    "builtInPackagesPath": { "type": ["string", "null"] },
    "manifestPath": { "type": "string" },
    "packagesLockPath": { "type": ["string", "null"] },
    "cacheDir": { "type": "string" }
  },
  "additionalProperties": false
}
