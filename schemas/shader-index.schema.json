{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unitybrain.local/schemas/shader-index.schema.json",
  "title": "ShaderSymbolIndex",
  "type": "object",
  "required": ["schemaVersion", "shaderNames", "properties", "symbolsByFile"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "shaderNames": { "type": "array", "items": { "type": "string" } },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "displayName", "type", "shaderFile"],
        "properties": {
          "name": { "type": "string" },
          "displayName": { "type": "string" },
          "type": { "type": "string" },
          "shaderFile": { "type": "string" }
        }
      }
    },
    "symbolsByFile": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "kind", "uri", "line", "column"],
          "properties": {
            "name": { "type": "string" },
            "kind": { "enum": ["function", "struct", "field", "macro", "cbuffer", "variable", "property"] },
            "signature": { "type": "string" },
            "returnType": { "type": "string" },
            "documentation": { "type": "string" },
            "uri": { "type": "string" },
            "line": { "type": "integer", "minimum": 0 },
            "column": { "type": "integer", "minimum": 0 },
            "containerName": { "type": "string" }
          }
        }
      }
    }
  }
}
