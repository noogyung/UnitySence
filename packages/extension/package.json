{
  "name": "unitybrain",
  "displayName": "UnityBrain",
  "description": "JetBrains Rider 수준의 Unity 개발 지능형 지원 확장 (ShaderLab/HLSL LSP, Roslyn 분석기, YAML 에셋 인덱서, .meta 자동 동기화).",
  "version": "1.1.4",
  "publisher": "unitybrain",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/unitybrain/unitybrain.git"
  },
  "keywords": [
    "unity",
    "unity3d",
    "shaderlab",
    "hlsl",
    "csharp",
    "roslyn",
    "uitoolkit",
    "gamedev"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "type": "module",
  "main": "./dist/extension.cjs",
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:ProjectSettings/ProjectVersion.txt",
    "workspaceContains:**/ProjectSettings/ProjectVersion.txt",
    "workspaceContains:Assets"
  ],
  "scripts": {
    "build": "node ../../tools/cli.mjs build:extension",
    "typecheck": "node ../../tools/cli.mjs typecheck",
    "test": "node ../../tools/cli.mjs test extension"
  },
  "dependencies": {
    "vscode-jsonrpc": "^8.2.0",
    "vscode-languageserver": "^9.0.1"
  },
  "devDependencies": {
    "vscode": "^1.90.0",
    "vitest": "^2.1.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "unity-shaderlab",
        "aliases": ["Unity ShaderLab", "ShaderLab"],
        "extensions": [".shader", ".urtshader"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "hlsl",
        "aliases": ["HLSL", "Unity HLSL"],
        "extensions": [".hlsl", ".hlsli", ".cginc", ".cg", ".compute", ".hlslinc", ".raytrace", ".fx", ".fxh"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "uxml",
        "aliases": ["Unity UXML", "UXML"],
        "extensions": [".uxml"]
      },
      {
        "id": "uss",
        "aliases": ["Unity USS", "USS"],
        "extensions": [".uss"]
      }
    ],
    "grammars": [
      {
        "language": "unity-shaderlab",
        "scopeName": "source.unity-shaderlab",
        "path": "./syntaxes/unity-shaderlab.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "unityBrain.generateEventFunctions",
        "title": "[UnityBrain] 유니티 이벤트 함수 자동 생성..."
      },
      {
        "command": "unityBrain.switchShaderKeywords",
        "title": "[UnityBrain] 셰이더 키워드 컨텍스트 전환..."
      },
      {
        "command": "unityBrain.toggleShaderKeyword",
        "title": "[UnityBrain] 셰이더 키워드 On/Off 전환"
      },
      {
        "command": "unityBrain.testCurrentShader",
        "title": "[UnityBrain] 현재 셰이더 Live Test 실행"
      },
      {
        "command": "unityBrain.showAssetUsages",
        "title": "[UnityBrain] 유니티 에셋 참조 위치 보기"
      },
      {
        "command": "unityBrain.rebuildAssetIndex",
        "title": "[UnityBrain] 유니티 에셋 인덱스 다시 구축"
      },
      {
        "command": "unityBrain.cleanOrphanMetaFiles",
        "title": "[UnityBrain] 고아 .meta 파일 정리"
      },
      {
        "command": "unityBrain.generateDebugConfig",
        "title": "[UnityBrain] 유니티 디버거 설정(launch.json) 생성"
      },
      {
        "command": "unityBrain.openUnityEditorLog",
        "title": "[UnityBrain] 유니티 에디터 콘솔 로그(Editor.log) 열기"
      },
      {
        "command": "unityBrain.csharpGoToDefinition",
        "title": "[UnityBrain] C# Unity 에셋/심볼 정의로 이동"
      },
      {
        "command": "unityBrain.refreshShaderExplorer",
        "title": "[UnityBrain] 셰이더 탐색기 새로고침"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "unityBrain.shaderExplorer",
          "name": "UnityBrain Shaders",
          "when": "unityBrain.isUnityProject"
        }
      ]
    },
    "keybindings": [
      {
        "command": "unityBrain.csharpGoToDefinition",
        "key": "f12",
        "when": "unityBrain.isUnityProject && editorTextFocus && editorLangId == csharp"
      }
    ],
    "snippets": [
      {
        "language": "unity-shaderlab",
        "path": "./snippets/shaderlab.json"
      },
      {
        "language": "hlsl",
        "path": "./snippets/hlsl.json"
      }
    ],
    "configuration": {
      "title": "UnityBrain",
      "properties": {
        "unityBrain.metaSync.enabled": {
          "type": "boolean",
          "default": true,
          "description": "[UnityBrain] 탐색기에서 에셋을 생성/변경/삭제할 때 .meta 파일 및 GUID를 자동으로 동기화합니다."
        },
        "unityBrain.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "[UnityBrain] 유니티 에셋 참조, 이벤트 콜백, 인스펙터 직렬화 값 및 셰이더 배리언트 CodeLens를 표시합니다."
        },
        "unityBrain.analyzers.enabled": {
          "type": "boolean",
          "default": true,
          "description": "[UnityBrain] Directory.Build.props를 통해 UnityBrain Roslyn 분석기 및 AdditionalFiles를 자동으로 주입합니다."
        },
        "unityBrain.unityEditorPath": {
          "type": "string",
          "default": "",
          "description": "[UnityBrain] CGIncludes 및 빌트인 패키지를 찾기 위한 Unity Editor 설치 디렉터리 수동 지정 경로(선택 사항)입니다."
        },
        "unityBrain.shader.format.indentSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "[UnityBrain] ShaderLab/HLSL 포매팅 들여쓰기 크기입니다 (0 이하면 에디터 tabSize를 따릅니다)."
        },
        "unityBrain.shader.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "[UnityBrain] ShaderLab/HLSL/Compute 정적 진단 및 SRP Batcher CBUFFER 검사를 활성화합니다."
        },
        "unityBrain.completion.showEventSnippets": {
          "type": "boolean",
          "default": true,
          "description": "[UnityBrain] C# MonoBehaviour/NetworkBehaviour 유니티 이벤트 함수 자동완성 제안을 표시합니다."
        }
      }
    }
  }
}
