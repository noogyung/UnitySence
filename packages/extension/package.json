{
  "name": "unitysense",
  "displayName": "UnitySense",
  "description": "JetBrains Rider 수준의 Unity 개발 지능형 지원 확장 (ShaderLab/HLSL LSP, Roslyn 분석기, YAML 에셋 인덱서, .meta 자동 동기화).",
  "version": "1.0.2",
  "publisher": "noogkim",
  "author": {
    "name": "NoogKim"
  },
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/noogyung/UnitySense.git"
  },
  "homepage": "https://github.com/noogyung/UnitySense#readme",
  "bugs": {
    "url": "https://github.com/noogyung/UnitySense/issues"
  },
  "qna": "marketplace",
  "galleryBanner": {
    "color": "#1e293b",
    "theme": "dark"
  },
  "keywords": [
    "unity",
    "shaderlab",
    "hlsl",
    "csharp",
    "roslyn"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "type": "module",
  "main": "./dist/extension.cjs",
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:ProjectSettings/ProjectVersion.txt",
    "workspaceContains:**/ProjectSettings/ProjectVersion.txt",
    "workspaceContains:Assets"
  ],
  "scripts": {
    "build": "node ../../tools/cli.mjs build:extension",
    "typecheck": "node ../../tools/cli.mjs typecheck",
    "test": "node ../../tools/cli.mjs test extension",
    "vscode:prepublish": "node ../../tools/cli.mjs build",
    "package:vsce": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-jsonrpc": "^8.2.0",
    "vscode-languageserver": "^9.0.1"
  },
  "devDependencies": {
    "vscode": "^1.90.0",
    "vitest": "^2.1.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "unity-shaderlab",
        "aliases": ["Unity ShaderLab", "ShaderLab"],
        "extensions": [".shader", ".urtshader"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "hlsl",
        "aliases": ["HLSL", "Unity HLSL"],
        "extensions": [".hlsl", ".hlsli", ".cginc", ".cg", ".compute", ".hlslinc", ".raytrace", ".fx", ".fxh"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "uxml",
        "aliases": ["Unity UXML", "UXML"],
        "extensions": [".uxml"]
      },
      {
        "id": "uss",
        "aliases": ["Unity USS", "USS"],
        "extensions": [".uss"]
      }
    ],
    "grammars": [
      {
        "language": "unity-shaderlab",
        "scopeName": "source.unity-shaderlab",
        "path": "./syntaxes/unity-shaderlab.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "unitySense.generateEventFunctions",
        "title": "[UnitySense] 유니티 이벤트 함수 자동 생성..."
      },
      {
        "command": "unitySense.switchShaderKeywords",
        "title": "[UnitySense] 셰이더 키워드 컨텍스트 전환..."
      },
      {
        "command": "unitySense.toggleShaderKeyword",
        "title": "[UnitySense] 셰이더 키워드 On/Off 전환"
      },
      {
        "command": "unitySense.testCurrentShader",
        "title": "[UnitySense] 현재 셰이더 Live Test 실행"
      },
      {
        "command": "unitySense.showAssetUsages",
        "title": "[UnitySense] 유니티 에셋 참조 위치 보기"
      },
      {
        "command": "unitySense.rebuildAssetIndex",
        "title": "[UnitySense] 유니티 에셋 인덱스 다시 구축"
      },
      {
        "command": "unitySense.cleanOrphanMetaFiles",
        "title": "[UnitySense] 고아 .meta 파일 정리"
      },
      {
        "command": "unitySense.generateDebugConfig",
        "title": "[UnitySense] 유니티 디버거 설정(launch.json) 생성"
      },
      {
        "command": "unitySense.openUnityEditorLog",
        "title": "[UnitySense] 유니티 에디터 콘솔 로그(Editor.log) 열기"
      },
      {
        "command": "unitySense.csharpGoToDefinition",
        "title": "[UnitySense] C# Unity 에셋/심볼 정의로 이동"
      },
      {
        "command": "unitySense.refreshShaderExplorer",
        "title": "[UnitySense] 셰이더 탐색기 새로고침"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "unitySense.shaderExplorer",
          "name": "UnitySense Shaders",
          "when": "unitySense.isUnityProject"
        }
      ]
    },
    "keybindings": [
      {
        "command": "unitySense.csharpGoToDefinition",
        "key": "f12",
        "when": "unitySense.isUnityProject && editorTextFocus && editorLangId == csharp"
      }
    ],
    "snippets": [
      {
        "language": "unity-shaderlab",
        "path": "./snippets/shaderlab.json"
      },
      {
        "language": "hlsl",
        "path": "./snippets/hlsl.json"
      }
    ],
    "configuration": {
      "title": "UnitySense",
      "properties": {
        "unitySense.metaSync.enabled": {
          "type": "boolean",
          "default": true,
          "description": "[UnitySense] 탐색기에서 에셋을 생성/변경/삭제할 때 .meta 파일 및 GUID를 자동으로 동기화합니다."
        },
        "unitySense.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "[UnitySense] 유니티 에셋 참조, 이벤트 콜백, 인스펙터 직렬화 값 및 셰이더 배리언트 CodeLens를 표시합니다."
        },
        "unitySense.analyzers.enabled": {
          "type": "boolean",
          "default": true,
          "description": "[UnitySense] 프로젝트 파일을 수정하지 않는 경량 C# Unity 정적 진단(성능/문자열/Burst)을 활성화합니다."
        },
        "unitySense.unityEditorPath": {
          "type": "string",
          "default": "",
          "description": "[UnitySense] CGIncludes 및 빌트인 패키지를 찾기 위한 Unity Editor 설치 디렉터리 수동 지정 경로(선택 사항)입니다."
        },
        "unitySense.shader.format.indentSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "[UnitySense] ShaderLab/HLSL 포매팅 들여쓰기 크기입니다 (0 이하면 에디터 tabSize를 따릅니다)."
        },
        "unitySense.shader.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "[UnitySense] ShaderLab/HLSL/Compute 정적 진단 및 SRP Batcher CBUFFER 검사를 활성화합니다."
        },
        "unitySense.completion.showEventSnippets": {
          "type": "boolean",
          "default": true,
          "description": "[UnitySense] C# MonoBehaviour/NetworkBehaviour 유니티 이벤트 함수 자동완성 제안을 표시합니다."
        }
      }
    }
  }
}
