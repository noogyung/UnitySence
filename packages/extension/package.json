{
  "name": "unitybrain",
  "displayName": "UnityBrain",
  "description": "JetBrains Rider-grade Unity development intelligence for VS Code (ShaderLab/HLSL LSP, Roslyn Analyzers, YAML Asset Indexer, Meta Sync).",
  "version": "0.1.0",
  "publisher": "unitybrain",
  "engines": {
    "vscode": "^1.90.0"
  },
  "type": "module",
  "main": "./dist/extension.js",
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:ProjectSettings/ProjectVersion.txt",
    "onLanguage:unity-shaderlab",
    "onLanguage:hlsl",
    "onLanguage:csharp",
    "onCommand:unityBrain.generateEventFunctions",
    "onCommand:unityBrain.switchShaderKeywords",
    "onCommand:unityBrain.showAssetUsages",
    "onCommand:unityBrain.rebuildAssetIndex"
  ],
  "extensionDependencies": [
    "ms-dotnettools.csharp",
    "visualstudiotoolsforunity.vstuc"
  ],
  "scripts": {
    "build": "node ../../tools/cli.mjs build:extension",
    "typecheck": "node ../../tools/cli.mjs typecheck",
    "test": "node ../../tools/cli.mjs test extension"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "vscode-jsonrpc": "^8.2.0"
  },
  "devDependencies": {
    "vscode": "^1.90.0",
    "vitest": "^2.1.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "unity-shaderlab",
        "aliases": ["Unity ShaderLab", "ShaderLab"],
        "extensions": [".shader", ".shadergraph", ".urtshader"]
      },
      {
        "id": "hlsl",
        "aliases": ["HLSL", "Unity HLSL"],
        "extensions": [".hlsl", ".hlsli", ".cginc", ".cg", ".compute", ".hlslinc"]
      }
    ],
    "grammars": [
      {
        "language": "unity-shaderlab",
        "scopeName": "source.shaderlab",
        "path": "./syntaxes/unity-shaderlab.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "unityBrain.generateEventFunctions",
        "title": "UnityBrain: Generate Unity Event Functions..."
      },
      {
        "command": "unityBrain.switchShaderKeywords",
        "title": "UnityBrain: Switch Shader Keywords Context..."
      },
      {
        "command": "unityBrain.showAssetUsages",
        "title": "UnityBrain: Show Unity Asset Usages"
      },
      {
        "command": "unityBrain.rebuildAssetIndex",
        "title": "UnityBrain: Rebuild Unity Asset Index"
      }
    ],
    "configuration": {
      "title": "UnityBrain",
      "properties": {
        "unityBrain.metaSync.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically rename, delete, and create Unity .meta files when assets change in Explorer."
        },
        "unityBrain.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Unity Asset Usage, Event Callback, Inspector Value, and Shader Variant CodeLenses."
        },
        "unityBrain.analyzers.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically inject UnityBrain Roslyn Analyzers and AdditionalFiles via Directory.Build.props."
        },
        "unityBrain.unityEditorPath": {
          "type": "string",
          "default": "",
          "description": "Optional explicit path to the Unity Editor executable directory for resolving CGIncludes and built-in packages."
        }
      }
    }
  }
}
