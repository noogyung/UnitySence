{
  "URP Unlit Shader": {
    "prefix": "urp-unlit-shader",
    "body": [
      "Shader \"${1:Custom/URPUnlit}\"",
      "{",
      "\tProperties",
      "\t{",
      "\t\t[MainTexture] _BaseMap (\"Base Map\", 2D) = \"white\" {}",
      "\t\t[MainColor] _BaseColor (\"Base Color\", Color) = (1, 1, 1, 1)",
      "\t}",
      "",
      "\tSubShader",
      "\t{",
      "\t\tTags { \"RenderType\" = \"Opaque\" \"RenderPipeline\" = \"UniversalPipeline\" \"Queue\" = \"Geometry\" }",
      "",
      "\t\tPass",
      "\t\t{",
      "\t\t\tName \"ForwardLit\"",
      "\t\t\tTags { \"LightMode\" = \"UniversalForward\" }",
      "",
      "\t\t\tHLSLPROGRAM",
      "\t\t\t#pragma vertex vert",
      "\t\t\t#pragma fragment frag",
      "",
      "\t\t\t#include \"Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl\"",
      "",
      "\t\t\tstruct Attributes",
      "\t\t\t{",
      "\t\t\t\tfloat4 positionOS : POSITION;",
      "\t\t\t\tfloat2 uv : TEXCOORD0;",
      "\t\t\t};",
      "",
      "\t\t\tstruct Varyings",
      "\t\t\t{",
      "\t\t\t\tfloat4 positionHCS : SV_POSITION;",
      "\t\t\t\tfloat2 uv : TEXCOORD0;",
      "\t\t\t};",
      "",
      "\t\t\tTEXTURE2D(_BaseMap);",
      "\t\t\tSAMPLER(sampler_BaseMap);",
      "",
      "\t\t\tCBUFFER_START(UnityPerMaterial)",
      "\t\t\t\tfloat4 _BaseMap_ST;",
      "\t\t\t\thalf4 _BaseColor;",
      "\t\t\tCBUFFER_END",
      "",
      "\t\t\tVaryings vert(Attributes IN)",
      "\t\t\t{",
      "\t\t\t\tVaryings OUT;",
      "\t\t\t\tOUT.positionHCS = TransformObjectToHClip(IN.positionOS.xyz);",
      "\t\t\t\tOUT.uv = TRANSFORM_TEX(IN.uv, _BaseMap);",
      "\t\t\t\treturn OUT;",
      "\t\t\t}",
      "",
      "\t\t\thalf4 frag(Varyings IN) : SV_Target",
      "\t\t\t{",
      "\t\t\t\thalf4 texColor = SAMPLE_TEXTURE2D(_BaseMap, sampler_BaseMap, IN.uv);",
      "\t\t\t\treturn texColor * _BaseColor;",
      "\t\t\t}",
      "\t\t\tENDHLSL",
      "\t\t}",
      "\t}",
      "}"
    ],
    "description": "[UnityBrain] URP 호환 Unlit Shader 전체 템플릿 (SRP Batcher 지원)"
  },
  "ShaderLab Pass Block": {
    "prefix": "shader-pass",
    "body": [
      "Pass",
      "{",
      "\tName \"${1:ForwardLit}\"",
      "\tTags { \"LightMode\" = \"${2:UniversalForward}\" }",
      "",
      "\tHLSLPROGRAM",
      "\t#pragma vertex ${3:vert}",
      "\t#pragma fragment ${4:frag}",
      "\t$0",
      "\tENDHLSL",
      "}"
    ],
    "description": "[UnityBrain] ShaderLab Pass + HLSLPROGRAM 블록"
  },
  "ShaderLab Stencil Block": {
    "prefix": "shader-stencil",
    "body": [
      "Stencil",
      "{",
      "\tRef ${1:1}",
      "\tComp ${2|Always,Equal,NotEqual,Less,Greater|}",
      "\tPass ${3|Keep,Replace,Zero|}",
      "}"
    ],
    "description": "[UnityBrain] ShaderLab Stencil 테스트 블록"
  }
}
