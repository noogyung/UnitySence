<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseSharedCompilation>false</UseSharedCompilation>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <Deterministic>true</Deterministic>
    <RestoreSources></RestoreSources>
    <NetCoreRefDir>C:/Program Files/dotnet/packs/Microsoft.NETCore.App.Ref/10.0.9/ref/net10.0</NetCoreRefDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../UnityBrain.Daemon.csproj" />
    <Reference Include="$(NetCoreRefDir)/*.dll" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <Target Name="WriteOfflineRuntimeConfig" AfterTargets="Build">
    <PropertyGroup>
      <OfflineRuntimeConfig>{"runtimeOptions":{"tfm":"net10.0","framework":{"name":"Microsoft.NETCore.App","version":"10.0.0"}}}</OfflineRuntimeConfig>
    </PropertyGroup>
    <WriteLinesToFile File="$(TargetDir)$(AssemblyName).runtimeconfig.json" Lines="$(OfflineRuntimeConfig)" Overwrite="true" />
  </Target>

  <Target Name="VSTest" DependsOnTargets="Build;WriteOfflineRuntimeConfig">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; &quot;$(VSTestTestCaseFilter)&quot;" />
  </Target>
</Project>
