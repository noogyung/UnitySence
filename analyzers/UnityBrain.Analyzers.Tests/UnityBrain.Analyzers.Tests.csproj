<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net$(NETCoreAppMaximumVersion)</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseSharedCompilation>false</UseSharedCompilation>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Deterministic>true</Deterministic>
    <RoslynToolsDir Condition="'$(RoslynToolsDir)' == ''">$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'DotnetTools', 'dotnet-format'))</RoslynToolsDir>
    <NetCoreRefDir Condition="'$(NetCoreRefDir)' == ''">$([System.IO.Path]::Combine('$(NetCoreRoot)', 'packs', 'Microsoft.NETCore.App.Ref', '$(BundledNETCoreAppPackageVersion)', 'ref', 'net$(NETCoreAppMaximumVersion)'))</NetCoreRefDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../UnityBrain.Analyzers/UnityBrain.Analyzers.csproj" />
    <Reference Include="$(NetCoreRefDir)/*.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.CodeAnalysis.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.CodeAnalysis.CSharp.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.CodeAnalysis.Workspaces.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.CodeAnalysis.CSharp.Workspaces.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.CodeAnalysis.Features.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.CodeAnalysis.CSharp.Features.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/System.Composition.AttributedModel.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/System.Composition.Runtime.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/System.Composition.TypedParts.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/System.Composition.Hosting.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/System.Composition.Convention.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Humanizer.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.DiaSymReader.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.CodeAnalysis.Elfie.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.Bcl.AsyncInterfaces.dll">
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <Target Name="Restore" />

  <Target Name="WriteOfflineRuntimeConfig" AfterTargets="Build">
    <PropertyGroup>
      <OfflineRuntimeConfig>{"runtimeOptions":{"tfm":"$(TargetFramework)","rollForward":"Major","framework":{"name":"Microsoft.NETCore.App","version":"$(NETCoreAppMaximumVersion).0"}}}</OfflineRuntimeConfig>
    </PropertyGroup>
    <WriteLinesToFile File="$(TargetDir)$(AssemblyName).runtimeconfig.json" Lines="$(OfflineRuntimeConfig)" Overwrite="true" />
  </Target>

  <Target Name="VSTest" DependsOnTargets="Build;WriteOfflineRuntimeConfig">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; &quot;$(VSTestTestCaseFilter)&quot;" />
  </Target>
</Project>
