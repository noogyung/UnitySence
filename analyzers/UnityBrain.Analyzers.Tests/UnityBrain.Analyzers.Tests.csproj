<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseSharedCompilation>false</UseSharedCompilation>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <Deterministic>true</Deterministic>
    <RoslynToolsDir>C:/Program Files/dotnet/sdk/10.0.301/DotnetTools/dotnet-format</RoslynToolsDir>
    <NetCoreRefDir>C:/Program Files/dotnet/packs/Microsoft.NETCore.App.Ref/10.0.9/ref/net10.0</NetCoreRefDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../UnityBrain.Analyzers/UnityBrain.Analyzers.csproj" />
    <Reference Include="$(NetCoreRefDir)/*.dll" />
    <Reference Include="$(RoslynToolsDir)/Microsoft.CodeAnalysis.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.CodeAnalysis.CSharp.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.CodeAnalysis.Workspaces.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.CodeAnalysis.CSharp.Workspaces.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.CodeAnalysis.Features.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.CodeAnalysis.CSharp.Features.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/System.Composition.AttributedModel.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/System.Composition.Runtime.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/System.Composition.TypedParts.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/System.Composition.Hosting.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/System.Composition.Convention.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Humanizer.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.DiaSymReader.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.CodeAnalysis.Elfie.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.Bcl.AsyncInterfaces.dll">
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <Target Name="Restore" />

  <Target Name="WriteOfflineRuntimeConfig" AfterTargets="Build">
    <PropertyGroup>
      <OfflineRuntimeConfig>{"runtimeOptions":{"tfm":"net10.0","framework":{"name":"Microsoft.NETCore.App","version":"10.0.0"}}}</OfflineRuntimeConfig>
    </PropertyGroup>
    <WriteLinesToFile File="$(TargetDir)$(AssemblyName).runtimeconfig.json" Lines="$(OfflineRuntimeConfig)" Overwrite="true" />
  </Target>

  <Target Name="VSTest" DependsOnTargets="Build;WriteOfflineRuntimeConfig">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; &quot;$(VSTestTestCaseFilter)&quot;" />
  </Target>
</Project>
