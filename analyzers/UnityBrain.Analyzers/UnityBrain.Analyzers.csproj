<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup Condition="'$(UseNuGetNetStandard)' == 'true'">
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseNuGetNetStandard)' != 'true'">
    <TargetFramework Condition="'$(TargetFramework)' == ''">net$(NETCoreAppMaximumVersion)</TargetFramework>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <EnforceExtendedAnalyzerRules>false</EnforceExtendedAnalyzerRules>
    <RoslynToolsDir Condition="'$(RoslynToolsDir)' == ''">$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'DotnetTools', 'dotnet-format'))</RoslynToolsDir>
    <NetCoreRefDir Condition="'$(NetCoreRefDir)' == ''">$([System.IO.Path]::Combine('$(NetCoreRoot)', 'packs', 'Microsoft.NETCore.App.Ref', '$(BundledNETCoreAppPackageVersion)', 'ref', 'net$(NETCoreAppMaximumVersion)'))</NetCoreRefDir>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>UnityBrain.Analyzers</AssemblyName>
    <RootNamespace>UnityBrain.Analyzers</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultItems>true</EnableDefaultItems>
    <UseSharedCompilation>false</UseSharedCompilation>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <Target Name="Restore" Condition="'$(UseNuGetNetStandard)' != 'true'" />

  <ItemGroup Condition="'$(UseNuGetNetStandard)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.3.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseNuGetNetStandard)' != 'true'">
    <Reference Include="$(NetCoreRefDir)/*.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.CodeAnalysis.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.CodeAnalysis.CSharp.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.CodeAnalysis.Workspaces.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/Microsoft.CodeAnalysis.CSharp.Workspaces.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/System.Composition.AttributedModel.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/System.Composition.Runtime.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/System.Composition.TypedParts.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(RoslynToolsDir)/System.Composition.Hosting.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
